@model List<EventsReg.Models.Event>

<h2>Lista wydarzeń</h2>

<a asp-action="Create">Dodaj nowe wydarzenie</a>

@if (Model.Count == 0)
{
    <p>Brak wydarzeń.</p>
}
else
{
    <ul>
        @foreach (var ev in Model)
        {
            <li>
                <a asp-action="Details" asp-route-id="@ev.Id">@ev.Title</a>
                - @ev.Date.ToShortDateString()
            </li>
        }
    </ul>
}

